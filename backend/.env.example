NODE_ENV=development
HOST=0.0.0.0
PORT=5000

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN_REGEX=

MONGO_URI=mongodb://127.0.0.1:27017/ragnexus_ai
JWT_SECRET=replace-with-a-strong-64-character-secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_TIMEOUT_MS=10000
GEMINI_EMBEDDING_TIMEOUT_MS=10000

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_DOCUMENT_COLLECTION=ragnexus_documents
CHROMA_FEEDBACK_COLLECTION=ragnexus_feedback_memory

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

ADMIN_NAME=RAGNEXUS Admin
ADMIN_EMAIL=admin@ragnexus.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
